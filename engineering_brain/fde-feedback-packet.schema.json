{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nexus-ai-2045/fractal-decision-ecosystem/blob/main/schemas/fde_feedback_packet.v1.schema.json",
  "title": "FDE cross-runtime feedback packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feedback_id",
    "source_run_id",
    "producer",
    "consumer",
    "observed_at",
    "plan",
    "do",
    "check",
    "act",
    "boundaries",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "fde.feedback.v1" },
    "feedback_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "consumer": { "const": "fde" },
    "observed_at": { "type": "string", "format": "date-time" },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "expected_effect", "verification_plan"],
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": ".*\\S.*"
        },
        "expected_effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": ".*\\S.*"
        },
        "verification_plan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": ".*\\S.*"
          }
        }
      }
    },
    "do": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "changed_artifacts"],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": ".*\\S.*"
          }
        },
        "changed_artifacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": ".*\\S.*"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "evidence", "human_review"],
      "properties": {
        "outcome": {
          "enum": ["met", "not_met", "partial", "unknown"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": {
                "enum": ["test", "log", "trace", "receipt", "review", "source"]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
              }
            }
          }
        },
        "human_review": {
          "enum": ["not_required", "pending", "approved", "rejected"]
        }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "failure_kind",
        "update_targets",
        "regression_test",
        "rollback_path",
        "next_plan_input"
      ],
      "properties": {
        "decision": { "enum": ["adopt", "hold", "reject", "revise"] },
        "failure_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": ".*\\S.*"
        },
        "update_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": ["route", "skill", "gate", "test", "ssot", "roadmap", "none"]
          }
        },
        "regression_test": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": ".*\\S.*"
        },
        "rollback_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": ".*\\S.*"
        },
        "next_plan_input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": ".*\\S.*"
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_actions_performed", "human_gate_required"],
      "properties": {
        "external_actions_performed": { "type": "boolean" },
        "human_gate_required": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs"],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "enum": ["source", "test", "log", "trace", "receipt", "review"] },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
              }
            }
          }
        }
      }
    }
  }
}
