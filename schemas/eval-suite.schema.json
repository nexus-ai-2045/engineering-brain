{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Brain Evaluation Suite",
  "type": "object",
  "required": ["id", "version", "baseline_arm", "arms", "thresholds", "metrics", "cases"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "baseline_arm": {"type": "string", "minLength": 1},
    "arms": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "model", "workflow", "tool_profile"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "workflow": {"type": "string", "minLength": 1},
          "tool_profile": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "thresholds": {
      "type": "object",
      "required": [
        "task_success_gain_min",
        "citation_support_min",
        "human_win_rate_min",
        "critical_misses_max",
        "boundary_violations_max",
        "cost_ratio_max"
      ]
    },
    "metrics": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "split", "domain", "prompt", "rubric"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "split": {"enum": ["development", "validation", "held_out"]},
          "domain": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "rubric": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
