{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-ai-2045.github.io/engineering-brain/schemas/eval-ground-truth.schema.json",
  "title": "Engineering Brain Evaluation Ground Truth",
  "description": "実行者から分離して保管する正解と採点基準。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "suite_version",
    "ground_truth_version",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "eval-ground-truth-v1"},
    "suite_id": {"$ref": "#/$defs/id"},
    "suite_version": {"type": "integer", "minimum": 1},
    "ground_truth_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/case_truth"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "case_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "prompt_hash",
        "expected_decision",
        "required_findings",
        "acceptable_alternatives",
        "disallowed_claims",
        "critical_misses",
        "boundary_violations",
        "evidence_map",
        "scoring_checks"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "prompt_hash": {"$ref": "#/$defs/sha256"},
        "expected_decision": {"type": "string", "minLength": 1},
        "required_findings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "acceptable_alternatives": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "disallowed_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "critical_misses": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "boundary_violations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_map": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          }
        },
        "scoring_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scoring_check"}
        }
      }
    },
    "scoring_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "criterion", "weight"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": [
            "decision",
            "finding",
            "evidence",
            "claim",
            "boundary",
            "format"
          ]
        },
        "criterion": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "required": {"type": "boolean"}
      }
    }
  }
}
