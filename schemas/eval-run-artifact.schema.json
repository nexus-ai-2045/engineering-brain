{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-ai-2045.github.io/engineering-brain/schemas/eval-run-artifact.schema.json",
  "title": "Engineering Brain Evaluation Run Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "suite",
    "case_id",
    "arm",
    "execution",
    "output",
    "usage",
    "tools",
    "sources",
    "reproducibility"
  ],
  "properties": {
    "schema_version": {"const": "eval-run-artifact-v1"},
    "run_id": {"$ref": "#/$defs/id"},
    "suite": {"$ref": "#/$defs/suite_ref"},
    "case_id": {"$ref": "#/$defs/id"},
    "arm": {"$ref": "#/$defs/arm_ref"},
    "execution": {"$ref": "#/$defs/execution"},
    "output": {"$ref": "#/$defs/output"},
    "usage": {"$ref": "#/$defs/usage"},
    "tools": {
      "type": "array",
      "items": {"$ref": "#/$defs/tool_event"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "reproducibility": {"$ref": "#/$defs/reproducibility"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "suite_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "suite_hash"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "suite_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "arm_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model",
        "workflow",
        "tool_profile",
        "system_prompt_hash"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "model": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "tool_profile": {"type": "string", "minLength": 1},
        "system_prompt_hash": {"$ref": "#/$defs/sha256"},
        "parameters_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "started_at", "ended_at", "duration_ms"],
      "properties": {
        "status": {"enum": ["completed", "failed", "timed_out", "cancelled"]},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "error": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sha256"],
      "properties": {
        "text": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "media_type", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "currency",
        "estimated_cost"
      ],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "estimated_cost": {"type": "number", "minimum": 0},
        "pricing_snapshot_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "tool",
        "request_hash",
        "response_hash",
        "started_at",
        "ended_at",
        "status"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "tool": {"type": "string", "minLength": 1},
        "request_hash": {"$ref": "#/$defs/sha256"},
        "response_hash": {"$ref": "#/$defs/sha256"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["succeeded", "failed", "blocked"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "content_hash", "observed_at"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "observed_at": {"type": "string", "format": "date-time"},
        "citation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_version",
        "runner_commit",
        "environment_hash",
        "input_hash",
        "random_seed",
        "command"
      ],
      "properties": {
        "runner_version": {"type": "string", "minLength": 1},
        "runner_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "environment_hash": {"$ref": "#/$defs/sha256"},
        "input_hash": {"$ref": "#/$defs/sha256"},
        "random_seed": {"type": "integer", "minimum": 0},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "repository_state_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
