{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "engineering-brain adoption unit",
  "type": "object",
  "required": [
    "id",
    "status",
    "source_refs",
    "applies_when",
    "timing",
    "boundary",
    "route",
    "guarantee_tier",
    "checks",
    "insufficient_if"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
    "status": { "enum": ["adopted", "candidate", "hold", "rejected"] },
    "source_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "applies_when": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "timing": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "boundary": { "type": "string", "minLength": 1 },
    "route": { "type": "string", "minLength": 1 },
    "guarantee_tier": { "type": "string", "pattern": "^G[0-6] .+" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["level", "command"],
        "properties": {
          "level": { "type": "string" },
          "command": { "type": ["string", "null"] }
        }
      }
    },
    "insufficient_if": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
