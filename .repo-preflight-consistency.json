{
  "$schema": "https://raw.githubusercontent.com/nexus-ai-2045/repo-preflight/main/schemas/repository-consistency.schema.json",
  "schema": "repo-preflight.consistency/v1",
  "mode": "shadow",
  "ratchet": {"baseline": []},
  "markdown": {"include": ["README.md", "CONTRIBUTING.md", "docs/**/*.md", "PREFLIGHT.md"]},
  "readme_contracts": {
    "required_paths": [
      "engineering_brain/cli.py",
      "engineering_brain/review.py",
      "schemas/pr-packet.schema.json"
    ],
    "commands": [
      {
        "text": "python -m engineering_brain pr --repo . --json",
        "paths": ["engineering_brain/cli.py", "engineering_brain/review.py"]
      },
      {
        "text": "python -m engineering_brain closeout --repo . --json",
        "paths": ["engineering_brain/cli.py", "engineering_brain/gates.py"]
      },
      {
        "text": "python -m pytest -q",
        "paths": ["pyproject.toml", "tests"]
      }
    ]
  },
  "impact_map": [
    {
      "change": ["engineering_brain/**", "schemas/**"],
      "requires_any": ["README.md", "docs/**", "tests/**"]
    },
    {
      "change": ["tools/**", ".github/workflows/**"],
      "requires_any": ["README.md", "CONTRIBUTING.md", "PREFLIGHT.md", "tests/**"]
    }
  ],
  "generated_artifacts": []
}
